# Per-request timeout (seconds) for provider HTTP calls.
# Valid: any positive number. Example: 5, 10, 15.
SEARCH_TIMEOUT_SECONDS=10

# Default max_results when the caller does not specify.
# Valid: 1..10 (upper bound enforced by the handler). Example: 5.
DEFAULT_MAX_RESULTS=5

# --- Brave Search ----------------------------------------------------
# Leave BRAVE_API_KEY empty to disable Brave. The server will log
# "Brave disabled" at startup and continue normally. Required for
# `balanced` and `precision` modes (see README mode-routing matrix).
BRAVE_API_KEY=

# Brave Search API base URL. Change only if you are targeting a
# non-default Brave endpoint. Default: https://api.search.brave.com
# BRAVE_API_BASE=https://api.search.brave.com

# Optional two-letter country code sent as Brave's `country` param
# (localizes results). Unset by default — add in your local .env.
# Valid: ISO 3166-1 alpha-2. Examples: US, GB, SG, DE, JP.
# BRAVE_DEFAULT_COUNTRY=

# Optional UI language hint sent as Brave's `search_lang` param.
# Unset by default — add in your local .env.
# Valid: two-letter language code. Examples: en, es, fr, de, ja.
# BRAVE_DEFAULT_SEARCH_LANG=

# Brave SafeSearch filter level sent on every query.
# Valid: off | moderate | strict. Default: moderate.
BRAVE_SAFESEARCH=moderate

# --- Exa -------------------------------------------------------------
# Leave EXA_API_KEY empty to disable Exa. The server will log
# "Exa disabled" at startup and continue normally. Required for
# `recall` and `precision` modes (see README mode-routing matrix).
EXA_API_KEY=

# Exa API base URL. Change only if you are targeting a non-default
# Exa endpoint. Default: https://api.exa.ai
# EXA_API_BASE=https://api.exa.ai

# Cap on the `numResults` value sent to Exa per request. The handler
# requests min(max_results, ceiling). Tune down to reduce per-call cost
# if you tend to query with high max_results.
# Valid: any positive integer. Default: 10.
# EXA_NUM_RESULTS_CEILING=10

# --- Serper ----------------------------------------------------------
# Leave SERPER_API_KEY empty to disable Serper. The server will log
# "Serper disabled" at startup and continue normally. Required for
# `balanced` and `recall` modes (see README mode-routing matrix).
SERPER_API_KEY=

# Serper API base URL. Change only if you are targeting a non-default
# Serper endpoint. Default: https://google.serper.dev
# SERPER_API_BASE=https://google.serper.dev

# Cap on the `num` value sent to Serper per request. The handler
# requests min(max_results, ceiling). Tune down to reduce per-call cost
# if you tend to query with high max_results.
# Valid: any positive integer. Default: 10.
# SERPER_NUM_RESULTS_CEILING=10

# --- Ranking ---------------------------------------------------------
# Window (in days) within which a result's published_date earns a
# recency bonus in the ranker. Tune for your domain's news cadence.
# Valid: any positive integer. Examples: 7, 30, 90. Default: 30.
RECENCY_WINDOW_DAYS=30

# --- fetch_url (Phase 4) ----------------------------------------------
# Total wall-clock budget (seconds) for one fetch_url call — covers the
# robots.txt fetch, every redirect hop, and the body read combined.
# Separate from SEARCH_TIMEOUT_SECONDS.
# Valid: any positive number. Default: 15.
# FETCH_URL_TIMEOUT_SECONDS=15

# Cap on the DECOMPRESSED response body, in bytes. Bodies larger than
# this are truncated with a warning and extraction proceeds on the
# truncated content. Valid: any positive integer. Default: 2000000.
# FETCH_URL_MAX_BODY_BYTES=2000000

# User-Agent header sent on fetch_url requests (including robots.txt).
# Default identifies this MCP: "web_search_mcp/0.4 (+fetch_url)".
# FETCH_URL_USER_AGENT=

# Whether fetch_url honors robots.txt (disallowed URLs return
# status="failed" without being fetched).
# Valid: true | false. Default: true.
# FETCH_URL_RESPECT_ROBOTS=true

# DANGER: setting true disables ALL private/local address blocking
# (loopback, RFC1918, link-local, CGNAT — including across redirects).
# Only enable for trusted internal use. The http/https scheme allowlist
# stays enforced regardless. Valid: true | false. Default: false.
# FETCH_URL_ALLOW_PRIVATE=false

# --- search_health (Phase 4) -------------------------------------------
# Set true to skip live provider probes — search_health then reports
# enablement and mode availability only (reachable/auth_ok stay null).
# Live probes cost one billable search call per enabled provider.
# Valid: true | false. Default: false.
# SEARCH_HEALTH_DRY_RUN=false
